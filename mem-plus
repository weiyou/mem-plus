#!/bin/zsh
# =============================================================================
# mem-plus - Compact, one-line JSON memory/CPU/power snapshot for processes
# =============================================================================
#
# Usage:
#     mem-plus <process-name-or-pattern>
#
# Example:
#     mem-plus llama-server
#     mem-plus mlx_lm.generate
#     mem-plus "llama-server|python"      # pattern is passed to pgrep -f
#
# -----------------------------------------------------------------------------
# WHAT IT PRINTS
# -----------------------------------------------------------------------------
# One JSON object PER MATCHING PROCESS, each on a single line. The single-line
# format is intentional so the output is easy to grep, pipe, and append to logs.
# To pretty-print, pipe through jq (see "BEAUTIFYING" below).
#
# Each line looks like:
#
#   {"<comm>": {"PID": N, "Mem": "..", "Mem Peak": "..", "RSS": "..",
#               "CPU%": "..", "NCPU%": ".."},
#    "Total": {"GPU Power": "..", "GPU%": "..",
#              "Mem BW": "..", "Mem BW Max": "..",
#              "Mem Used": "..", "Mem Pressure": "..", "Mem Free%": ".."}}
#
# Fields:
#   <comm>      Last 80 chars of the process command path (the JSON key).
#   PID         Process id.
#   Mem         Physical footprint (memfoot helper). What Activity Monitor calls
#               "Memory". The number you should trust for real RAM cost.
#   Mem Peak    Peak physical footprint since the process started.
#   RSS         Resident Set Size (ps -o rss), in MB. A cross-check metric;
#               see "RSS vs Mem" below for why it can differ wildly.
#   CPU%        Instantaneous %CPU, htop-style. Measured with `top -l 2 -s 1`
#               and reading the SECOND sample, which is a delta over a 1s
#               interval. Sums across cores, so a process pinning N threads can
#               exceed 100%. (See "WHY CPU% IS MEASURED THIS WAY" below.)
#   NCPU%       CPU% normalized by logical core count (hw.ncpu): CPU% / ncpu.
#               Caps at ~100% = the process is using the entire machine.
#   Total       System-wide metrics, sampled ONCE per invocation:
#     GPU Power   GPU power from the IOReport "GPU Energy" channel (memgpu
#                 helper, no sudo). The mJ "GPU" channel is the fallback when
#                 "GPU Energy" does not move. N/A if memgpu is missing.
#     GPU%        GPU HW active residency from IOReport GPUPH (memgpu). Same
#                 residency powermetrics calls "GPU HW active residency".
#                 N/A if memgpu is missing.
#     Mem BW      DRAM read+write bandwidth in GB/s (membw helper, see below).
#     Mem BW Max  Session high-water mark for Mem BW: the highest value seen
#                 across repeated mem-plus runs. Persisted in
#                 /tmp/mem-plus-membw-max; delete that file to reset it.
#     Mem Used    System-wide RAM used (memsys helper). The "Memory Used" label
#                 in Activity Monitor: physical - file-backed - empty free.
#                 That is larger than App + Wired + Compressed. Cached Files
#                 already includes purgeable pages, and the label still counts them.
#     Mem Pressure System memory pressure: Normal, Warn, or Critical — derived
#                 from memorystatus_get_level() free % (AM's pressure graph).
#     Mem Free%   Percent of RAM available (memorystatus_get_level; same as
#                 memory_pressure(1)'s "System-wide memory free percentage").
#
# Note: the "Total" block is system-wide (a single sample), not per-process, so
# it repeats identically on every process line.
#
# Units: memory sizes (Mem, Mem Peak, Mem Used, RSS) use 1024-based divisors
# (MiB/GiB) but are labeled MB/GB like Activity Monitor. Mem BW uses decimal
# 10^9 bytes/s (GB/s) — the throughput convention, not 1024-based.
#
# Why Mem BW comes from a bundled helper, not powermetrics: powermetrics on
# Apple Silicon exposes no memory-bandwidth sampler (its samplers are only
# tasks, battery, network, disk, interrupts, cpu_power, thermal, sfi, gpu_power,
# ane_power). DRAM bandwidth lives only in the private IOReport framework. The
# `membw` binary (compiled from membw.c that ships next to this script) prints
# combined DRAM GB/s with no sudo. Base M4: AMC "DCS RD"/"DCS WR" byte
# counters, which subscribe as a normal user. M4 Pro / M4 Max: AMC Stats
# will not subscribe, so PMP "DCS BW" AMCC histograms are used instead.
# It never opens a disk/NVMe IOKit
# user client, so it cannot lock out smartctl the way a full mactop sample can.
# Build once:
#     clang -O2 -framework CoreFoundation -o membw membw.c
#
# GPU Power and GPU% come from memgpu (memgpu.c), also IOReport, also no sudo.
# CPU package power is not reported: the Energy Model mJ counters behind
# powermetrics' "CPU Power" are visible without root but do not advance, so
# an unsudoed reading is a hard 0 W on a busy CPU. powermetrics is not called.
# Build once:
#     clang -O2 -framework CoreFoundation -o memgpu memgpu.c
#
# Why Mem comes from memfoot, not vmmap: vmmap walks every VM region via
# task_read_for_pid + mach_vm_region_recurse to recompute the same headline
# phys_footprint that Activity Monitor shows. On processes with thousands of
# regions (mpv, llama-server) that invasive sweep can hitch live playback.
# memfoot reads the kernel ledger via proc_pid_rusage in one syscall — same
# numbers, no region walk. Use vmmap manually when you need per-region detail.
# Build once:
#     clang -O2 -o memfoot memfoot.c
#
# System Mem Used / Pressure / Free% come from memsys (memsys.c):
# hw.memsize - file-backed - empty free for the Memory Used label,
# memorystatus_get_level() for free % / pressure.
# Build once:
#     clang -O2 -o memsys memsys.c
#
# -----------------------------------------------------------------------------
# RSS vs Mem — WHY THEY DISAGREE (and which to trust)
# -----------------------------------------------------------------------------
# These two numbers measure different things, and different inference engines
# stress opposite ends of that difference:
#
#   RSS (ps -o rss)            Every physical RAM page mapped into the process,
#                              INCLUDING shared libraries and clean, file-backed
#                              pages (e.g. an mmap'd model file). EXCLUDES
#                              compressed/swapped memory.
#
#   Mem / Mem Peak (memfoot /   Apple's "physical footprint" — the memory the
#   proc_pid_rusage)           process is actually CHARGED for (Activity
#                              Monitor's "Memory" column). EXCLUDES clean
#                              reclaimable file-backed pages; INCLUDES dirty
#                              pages, compressed memory, and IOKit/GPU (Metal)
#                              allocations.
#
# Real data from this tool:
#
#   llama-server   ->  "Mem": "845.5M", "RSS": "3098.3 MB"   (RSS >> Mem)
#   mlx_lm python  ->  "Mem": "7.4G",   "RSS": "1789.4 MB"   (Mem >> RSS)
#
# Why each diverges:
#
#   * llama.cpp (llama-server) mmaps the GGUF model by default. Those model
#     pages are clean and file-backed, so they count fully in RSS (they sit in
#     RAM) but barely in physical footprint (the OS can drop them for free, so
#     the process isn't billed). The gap IS the mmap'd weights.
#
#   * MLX (mlx_lm) uses Apple unified memory: tensors live in Metal/IOKit GPU
#     buffers. Those allocations are charged to physical footprint (watch
#     "Mem Peak" jump during inference) but the GPU-wired/IOKit memory is not
#     counted in the traditional ps resident set, so RSS looks small.
#     Compressed pages widen the gap further.
#
# Takeaway: trust "Mem" (physical footprint) for real RAM cost on both engines.
# RSS over-reports for mmap-based loaders (llama.cpp) and under-reports for
# GPU/unified-memory engines (MLX). Seeing both side by side is a quick way to
# tell whether a process is mmap-heavy or GPU-allocation-heavy at a glance.
#
# -----------------------------------------------------------------------------
# WHY CPU% IS MEASURED THIS WAY (and not with `ps`)
# -----------------------------------------------------------------------------
# Earlier versions read `ps -o %cpu` (and `ps -o cpu`). Both are wrong for a
# live "what is it doing right now" snapshot:
#
#   * `ps -o %cpu` is, per `man ps`, "a decaying average over up to a minute".
#     On Darwin it behaves essentially as CPU-time / elapsed-time for
#     long-lived processes. A server up for hours that is mostly idle with
#     occasional bursts averages to ~0% — the 15-30% bursts you see in htop
#     get smeared across the whole process lifetime. That is why CPU% read
#     0.0% even while htop showed real load.
#
#   * `ps -o cpu` is "short-term CPU usage factor (for scheduling)" — the
#     kernel's raw scheduler-decay counter (p_estcpu), NOT a percentage. It is
#     near 0 almost always. (This was the old data source for "NCPU%". NCPU% is
#     now derived from the good top number instead: CPU% / logical core count.)
#
# An accurate instantaneous %CPU requires sampling cumulative CPU time TWICE
# over an interval and dividing the delta by wall-clock time — exactly what
# htop/top do and what a single `ps` snapshot cannot. So this tool runs ONE
# `top -l 2 -s 1` for all matched PIDs at once and reads the SECOND sample
# (the first sample is cumulative; only the second is a true 1s delta).
#
# Cost: this adds ~1 second of latency per invocation (top must wait one
# interval to measure a delta). That is the unavoidable price of a real CPU%.
#
# -----------------------------------------------------------------------------
# BEAUTIFYING THE OUTPUT (jq)
# -----------------------------------------------------------------------------
# The raw output is intentionally one line per process. Pipe through jq to
# pretty-print:
#
#     mem-plus llama-server | jq .
#
# -----------------------------------------------------------------------------
# WATCHING / REPEATING (no `watch` needed)
# -----------------------------------------------------------------------------
# A plain zsh loop re-runs it on an interval. Ctrl-C to stop:
#
#     while :; do date "+%Y%m%d-%H%M%S"; mem-plus "llama-server|python" | jq .; sleep 10; done
#
# sleep 10 is the recommended default (human-facing snapshot, not a profiler).
# Each invocation already takes ~1.5–2 s (memgpu 300 ms, membw 200 ms,
# top -l 2 -s 1 a full second), so the real period is ~12 s — well above XNU's
# 1 s host_statistics64 cache window. 2–3 s only if you are watching a live
# generation (GPU%/BW); 30–60 s for a babysitter; do not go under ~2 s unless
# you drop top.
#
# The loop does NOT cache Mem Used (fresh memsys each iteration). If that
# field looks glued across 10 s ticks, it is almost never loop state: either
# %.2f GB really did not move (~11 MB/step), pgrep -f matched the watcher
# itself and you are staring at a wall of identical Total blocks, or the
# current top call hung (date printed, previous jq still on screen). See
# README "Watching / Repeating" and "Why Mem Used can look frozen in a
# watch loop".
#
# -----------------------------------------------------------------------------
# REQUIREMENTS / NOTES
# -----------------------------------------------------------------------------
#   * macOS (uses memfoot, memgpu, ps -o comm/rss). No sudo.
#   * Mem / Mem Peak come from the bundled `memfoot` helper (memfoot.c), which
#     must be compiled once: clang -O2 -o memfoot memfoot.c
#     It reads phys_footprint via proc_pid_rusage (same source as Activity
#     Monitor) and does not walk VM regions like vmmap, so it won't hitch mpv
#     or other live workloads. If the memfoot binary is missing, Mem reads N/A.
#   * Mem Used / Mem Pressure / Mem Free% come from `memsys` (memsys.c):
#     clang -O2 -o memsys memsys.c — Activity Monitor's system-wide memory tab.
#   * The "Mem BW" fields come from the bundled `membw` helper (membw.c), which
#     must be compiled once: clang -O2 -framework CoreFoundation -o membw membw.c
#     No sudo. Base M4 uses AMC Stats byte counters; M4 Pro / M4 Max use
#     PMP histograms. If the membw binary is missing, "Mem BW" reads
#     "N/A GB/s" and everything else still works.
#   * GPU Power / GPU% come from `memgpu` (memgpu.c):
#     clang -O2 -framework CoreFoundation -o memgpu memgpu.c
#     No sudo. "GPU Energy" (nJ) for power, GPUPH residency for GPU%.
#     If the binary is missing, those two fields read N/A.
#   * jq is only needed if you want pretty output; the tool itself emits valid
#     JSON without it.
# =============================================================================

if [ -z "$1" ]; then
    echo "Usage: mem-plus <process-name-or-pattern>"
    echo "Example: mem-plus mlx_lm.generate"
    exit 1
fi

PATTERN="$1"
# === Memory bandwidth sampling interval (in seconds) ===
# Default = 1.0 (1 second average)
# Use shorter values (e.g. 0.1 or 0.15) for better peak resolution during
# bursty workloads like MLX generation. Set via:
#     MEMPLUS_BW_INTERVAL=0.1 mem-plus mlx_lm.generate
bw_interval=${MEMPLUS_BW_INTERVAL:-0.2}

# === System-wide memory bandwidth via the bundled membw helper ===
# powermetrics on Apple Silicon has NO bandwidth sampler. DRAM bandwidth lives
# only in the private IOReport framework. `membw` (built from membw.c next to
# this script) prints combined read+write GB/s and does not call sudo.
# Base M4: AMC "DCS RD"/"DCS WR" byte counters subscribe as a normal user.
# M4 Pro / M4 Max: AMC Stats will not subscribe, so PMP "DCS BW"/AMCC
# histograms are used instead. It opens no disk/NVMe user client, so it does
# NOT interfere with smartctl. Build once:
#     clang -O2 -framework CoreFoundation -o membw membw.c
membw_bin="${0:A:h}/membw"
printf "Sampling memory bandwidth..." >&2
if [ -x "$membw_bin" ]; then
    membw=$("$membw_bin" "$bw_interval" 2>/dev/null)
    membw=$(awk -v v="$membw" 'BEGIN{if (v=="") exit 1; printf "%.1f", v}') || membw=""
fi
printf " Done\n" >&2

# === GPU power and HW active residency (IOReport, no sudo) ===
# memgpu prints "<milliwatts> <percent>". CPU package power is omitted: the
# Energy Model mJ counters do not advance without root, so a reading would be
# a false 0 W. See memgpu.c. Default window is 0.3 s (the old powermetrics
# interval). Override with MEMPLUS_GPU_INTERVAL.
gpu_power=""; gpu_pct=""
memgpu_bin="${0:A:h}/memgpu"
gpu_interval=${MEMPLUS_GPU_INTERVAL:-0.3}
printf "Sampling GPU..." >&2
if [ -x "$memgpu_bin" ]; then
    read -r gpu_mw gpu_raw <<< "$("$memgpu_bin" "$gpu_interval" 2>/dev/null)"
    if [[ "$gpu_mw" == <-> ]]; then
        gpu_power="${gpu_mw}mW"
    fi
    if [[ "$gpu_raw" == <-> || "$gpu_raw" == <->.<-> ]]; then
        gpu_pct="${gpu_raw}%"
    fi
fi
printf " Done\n" >&2

# === System-wide memory used + pressure (Activity Monitor Memory tab) ===
memsys_bin="${0:A:h}/memsys"
mem_used=""; mem_pressure=""; mem_free_pct=""
if [ -x "$memsys_bin" ]; then
    read -r mem_used_gb mem_pressure mem_free_pct <<< "$("$memsys_bin" 2>/dev/null)"
    mem_used="${mem_used_gb} GB"
    mem_free_pct="${mem_free_pct}%"
fi

# "Mem BW Max" is a decaying high-water mark, persisted in /tmp. It is the
# highest Mem BW seen, but it FORGETS a peak that has not been matched or beaten
# for MEMPLUS_BW_WINDOW_SEC seconds (default 900). This gives a "quasi rolling
# window": because mem-plus is short-lived and typically run on a short interval
# (e.g. every 10s), the displayed max stays close to the highest value seen in
# the trailing window without storing any timestamped history.
#
# The trick is in WHEN we touch the file. The file's mtime marks the moment the
# current max was last set/raised — NOT the last invocation — because we only
# rewrite the file on a new high or on expiry. Lower samples leave it untouched,
# so its mtime (and thus the decay clock) is preserved. Steps:
#   * file missing or older than the window  -> stale: reseed max := current
#   * current > stored max                   -> new high: max := current
#   * otherwise                              -> leave file alone (preserve mtime)
# On decay we reseed from the current sample (not the second-highest in-window
# value), so the max may briefly under-report right after a peak expires, then
# recover as fresh samples arrive. That is the accepted cost of skipping any
# timestamp bookkeeping. Delete the file to reset immediately.
membw_max_file="/tmp/mem-plus-membw-max"
# `sudo mem-plus` used to leave this file owned by root, so a later unsudo'd
# run could read the peak but not update it. Fall back to a uid file then.
if [ -e "$membw_max_file" ] && [ ! -w "$membw_max_file" ]; then
    membw_max_file="/tmp/mem-plus-membw-max.$(id -u)"
fi
membw_window=${MEMPLUS_BW_WINDOW_SEC:-900}
prev_max=$(cat "$membw_max_file" 2>/dev/null)
file_mtime=$(stat -f %m "$membw_max_file" 2>/dev/null)
now=$(date +%s)
cur=${membw:-0}

if [ -z "$file_mtime" ] || [ $((now - file_mtime)) -ge "$membw_window" ]; then
    # Missing or stale -> reseed the high-water mark from the current sample.
    membw_max=$(awk -v c="$cur" 'BEGIN{printf "%.1f", c}')
    echo "$membw_max" > "$membw_max_file" 2>/dev/null
elif awk -v c="$cur" -v p="${prev_max:-0}" 'BEGIN{exit !(c+0 > p+0)}'; then
    # New high -> raise the mark and restart the decay clock (mtime bumps).
    membw_max=$(awk -v c="$cur" 'BEGIN{printf "%.1f", c}')
    echo "$membw_max" > "$membw_max_file" 2>/dev/null
else
    # Current is not higher and not stale -> keep the stored max, DON'T write
    # (preserving mtime so the decay clock keeps counting from the last peak).
    membw_max=$(awk -v p="${prev_max:-0}" 'BEGIN{printf "%.1f", p}')
fi

# === Collect matching PIDs ===
pids=($(pgrep -f "$PATTERN"))
[ ${#pids[@]} -eq 0 ] && exit 0

# === Instantaneous %CPU for ALL pids in one shot (htop-style) ===
# `top -l 2 -s 1` emits two samples; the SECOND is a true 1s delta. We keep the
# last value seen per pid (= second sample). See header docs for the rationale.
pid_args=()
for p in $pids; do pid_args+=(-pid $p); done
top_data=$(top -l 2 -s 1 $pid_args -stats pid,cpu 2>/dev/null)

# Logical core count, for normalizing CPU% (NCPU% = CPU% / ncpu)
ncpu=$(sysctl -n hw.ncpu 2>/dev/null)
ncpu=${ncpu:-1}

typeset -A cpu_map
while read -r tp tc; do
    cpu_map[$tp]=$tc
done < <(echo "$top_data" | awk '$1 ~ /^[0-9]+$/ {print $1, $2}')

memfoot_bin="${0:A:h}/memfoot"

# === Process loop ===
for pid in $pids; do
    # Get last 80 characters of full command path
    full_comm=$(ps -o comm= -p $pid)
    proc_name=${full_comm: -80}

    # Memory — phys_footprint via proc_pid_rusage (Activity Monitor's source).
    # Unlike vmmap, this does not walk every VM region and won't hitch mpv.
    mem=""; mem_peak=""
    if [ -x "$memfoot_bin" ]; then
        read -r mem mem_peak <<< "$("$memfoot_bin" "$pid" 2>/dev/null)"
    fi

    # RSS (resident set size) for comparison, like mem() in zshrc
    rss=$(ps -o rss= -p $pid | awk '{printf "%.1f MB", $1/1024}')

    # CPU — instantaneous, from the top -l 2 second-sample map above.
    # CPU% sums across cores; NCPU% normalizes by logical core count.
    cpu_raw=${cpu_map[$pid]:-0}
    cpu_pct=$(printf "%.1f" "$cpu_raw")
    ncpu_pct=$(awk -v c="$cpu_raw" -v n="$ncpu" 'BEGIN{printf "%.1f", c/n}')

    # Valid JSON output (one line per process — pipe to `jq .` to beautify)
    cat <<EOF
{"$proc_name": {"PID": $pid, "Mem": "${mem:-N/A}", "Mem Peak": "${mem_peak:-N/A}", "RSS": "${rss:-N/A}", "CPU%": "${cpu_pct}%", "NCPU%": "${ncpu_pct}%"}, "Total": {"GPU Power": "${gpu_power:-N/A}", "GPU%": "${gpu_pct:-N/A}", "Mem BW": "${membw:-N/A} GB/s", "Mem BW Max": "${membw_max:-N/A} GB/s", "Mem Used": "${mem_used:-N/A}", "Mem Pressure": "${mem_pressure:-N/A}", "Mem Free%": "${mem_free_pct:-N/A}"}}
EOF

done
